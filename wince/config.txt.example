# carlive WinCE 车机端配置 (tuptup.top)
#
# 【当前模式】usb_adb = 走 ADB 隧道（R29 起默认，最稳）
#   车机连手机 adbd:5555 并做 RSA 鉴权，OPEN tcp:8686。
#   全程【不碰 GetAdaptersInfo / 网卡枚举】，候选 IP 只来自 UDP 8687 信标，
#   因此不受车机 CE ROM 上"网卡枚举踩堆崩溃"影响（R13~R28 的全部闪退根因）。
#   前提：手机已开「USB 调试」且 adbd 在 TCP 5555 监听——
#         开发者选项里开「USB 调试」+「网络 ADB 调试 / 无线调试」，或手机端执行 adb tcpip 5555。
#   注意：tuptup-usbnet.exe 是单 usb_net 变体，无视本行、永远走 usb_net。
#
# 【备选模式】改成 usb_net = 直连手机 8686（R29 也已修复，不再崩）
#   依赖手机 USB 网络共享给车机供网。R29 用「2x 缓冲+重试」安全封装 GetAdaptersInfo，
#   旧版"枚举越界踩堆"崩溃已消除。手机同网段地址通常是 192.168.42.129（rndis 网关）。
#
# host：留空 = 自动发现（靠信标 UDP 8687 找手机，换手机不用改）
port=8686
mode=usb_adb

# R27 排障开关（R29 后已成冗余安全网，一般不必动）：noLocalIP=1 会【完全跳过 GetAdaptersInfo】。
#   用法：去掉下面那行的 # 即生效，不用重新构建、不用跑 CI。
#   说明：三个 exe 共用本文件。R28 起它们各有独立互斥体，运行时互不拦截。
#   代价：本机 IP 相关功能失效（网段变化判定、网关推导候选、写死 IP 同子网校验）；
#         UDP 信标发现与子网主动扫描仍可用。每条日志回显 noLocalIP=0/1。
#noLocalIP=1
