<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：与车机 TCP 通信 + UDP 自动发现信标 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- USB：检测设备插入并自动开启网络共享（车机 USB 直连） -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 录屏：MediaProjection 需要前台服务（Android 10+ 必须声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 保活：CPU 常驻(防后台冻结) + 申请忽略电池优化(根治 OnePlus 等 OEM 后台杀进程导致 8686 失活) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 悬浮窗（可选，用于镜像状态提示） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 插线/拔线自启：监听 USB 状态变化，无需 App 预先运行 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 透明授权页：缺录屏授权时弹出系统“开始”弹窗（用户点一次） -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- 插线/拔线自启广播接收器：车机 USB 线插入即拉起服务，拔出即停止（日用机轻量） -->
        <receiver
            android:name=".UsbPlugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USB_STATE" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>

        <!-- 录屏前台服务 -->
        <service
            android:name=".MirrorForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 触摸回注：无障碍服务（无需 root，WiFi 直连可用） -->
        <service
            android:name=".MirrorAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
